PROJECT_NAME="Backend Taller Narbus"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=narbus_local

# Database URL format for SQLAlchemy
# Sync (psycopg2): postgresql://user:password@localhost:5432/dbname
# Async (asyncpg): postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/narbus_local
