# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN DE VARIABLES DE ENTORNO - BACKEND TALLER NARBUS
# ==============================================================================
# Copie este archivo como '.env' en la raíz del proyecto y configure los valores
# según su entorno (desarrollo local, pruebas en Docker o producción en la nube).
# En producción (Cloud Run), inyecte estas variables mediante Secret Manager / Cloud Run.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PERFIL Y METADATOS DEL SERVIDOR
# ------------------------------------------------------------------------------
# Perfil de ejecución:
#   - dev_local  : Desarrollo en máquina local (Swagger /docs habilitado, CORS permisivo para desarrollo)
#   - dev_lan    : Pruebas en red local / Wi-Fi de taller (habilita conexiones desde dispositivos móviles)
#   - production : Entorno de producción (Swagger deshabilitado, CORS estricto, logging estructurado)
ENVIRONMENT=dev_local

# Nombre y versión de la API (mostrados en encabezados y documentación OpenAPI)
PROJECT_NAME=Backend Taller Narbus
VERSION=0.1.0

# Prefijo global de rutas para todos los endpoints de la API v1
API_V1_STR=/api/v1

# Dirección IP y puerto donde escuchará Uvicorn:
#   - Para desarrollo local en host: HOST=127.0.0.1
#   - Para contenedores Docker:      HOST=0.0.0.0 (permite recibir tráfico exterior a través del puerto mapeado)
HOST=0.0.0.0
PORT=8000


# ------------------------------------------------------------------------------
# 2. POLÍTICAS DE ACCESO CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Lista de URLs/orígenes del Frontend autorizados para realizar peticiones HTTP hacia la API.
# NOTA CRÍTICA PARA PRODUCCIÓN:
# En 'production', el backend desactiva el comodín de desarrollo por seguridad.
# DEBE especificar aquí de forma explícita el dominio o subdominio real donde esté alojado su Frontend.
# Formato: URLs completas (con protocolo http/https y puerto si aplica), separadas por comas.
# Ejemplos:
#   - Local / Docker:   http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
#   - Producción Cloud: https://taller.narbus.cl,https://admin.narbus.cl
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Expresión regular opcional para validar orígenes dinámicos (útil si usa preview deploys o apps Capacitor móviles):
# CORS_ORIGIN_REGEX=^https:\/\/.*\.narbus\.cl$


# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y AUTENTICACIÓN (JWT - JSON Web Tokens)
# ------------------------------------------------------------------------------
# Clave criptográfica secreta utilizada para firmar y validar los tokens JWT.
# EN PRODUCCIÓN: Debe ser una cadena aleatoria de alta entropía (mínimo 32 o 64 caracteres)
# generada con openssl rand -hex 32 y custodiada en Google Secret Manager.
SECRET_KEY=narbus_secret_key_taller_2026_super_secure_jwt_token_change_in_prod

# Algoritmo de encriptación simétrica para la firma del token
ALGORITHM=HS256

# Tiempo de vida del token de sesión en minutos (1440 min = 24 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ------------------------------------------------------------------------------
# 4. BASE DE DATOS (PostgreSQL / Neon Cloud / Docker)
# ------------------------------------------------------------------------------
# Cadena de conexión principal. El backend adapta automáticamente los esquemas:
#   - SQLAlchemy Async : Convierte 'postgresql://' a 'postgresql+asyncpg://' con ssl=require
#   - Alembic Sync     : Utiliza 'postgresql://' con psycopg2
#
# Ejemplos de conexión:
#   - Neon Cloud (Producción / Remoto):
#     DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xyz-pooler.c-3.us-east-2.aws.neon.tech/taller?sslmode=require
#   - PostgreSQL local en host:
#     DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/narbus_local
#   - PostgreSQL en red Docker:
#     DATABASE_URL=postgresql+asyncpg://postgres:postgres@narbus-db:5432/taller_narbus
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xyz-pooler.c-3.us-east-2.aws.neon.tech/taller?sslmode=require

# Parámetros desglosados (utilizados como fallback si DATABASE_URL no está definida):
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taller_narbus

# Control de ejecución de migraciones de Alembic en el contenedor ('docker-entrypoint.sh'):
#   - true  : Aplica 'alembic upgrade head' de manera automática antes de iniciar Uvicorn.
#   - false : Inicia Uvicorn sin tocar el esquema de base de datos.
RUN_MIGRATIONS=true


# ------------------------------------------------------------------------------
# 5. ALMACENAMIENTO DE EVIDENCIAS Y MULTIMEDIA (Storage Provider)
# ------------------------------------------------------------------------------
# Estrategia de almacenamiento para fotos de averías y reportes de neumáticos:
#   - "local" : Almacena los archivos en el disco local dentro del directorio './uploads/'
#   - "gcs"   : Sube los archivos directamente a un bucket de Google Cloud Storage
STORAGE_PROVIDER=local

# Nombre del bucket en Google Cloud Storage (requerido solo si STORAGE_PROVIDER=gcs)
GCS_BUCKET_NAME=narbus-taller-media

# ID del proyecto de Google Cloud (requerido si STORAGE_PROVIDER=gcs)
GCS_PROJECT_ID=narbus-production

# Ruta a la credencial JSON de Service Account (solo requerida para pruebas locales con GCS):
# En Cloud Run no se requiere ya que se autentica automáticamente vía IAM (Application Default Credentials).
# GOOGLE_APPLICATION_CREDENTIALS=credentials/gcp-sa-key.json

# Límite máximo permitido para subida de imágenes en bytes (10485760 bytes = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760
